{
	//https://github.com/dotnet/docfx/tree/main/docs/docs
	"metadata": [
		// IMPORTANT:
		// we use a custom docfx build to handle namespace conflicts:
		// https://github.com/dotnet/docfx/issues/8966
		// see docfx/README.md for how it is produced.
		//
		// `assemblyUidPrefixes` maps assembly name -> UID prefix. It is combined across all entries,
		// which is what makes references *between* entries resolve, so it is declared once here.
		//
		// `uidPrefix` prefixes the APIs of the assemblies documented by its own entry. The four
		// EntityFrameworkCore entries all build an assembly named `linq2db.EntityFrameworkCore`, so
		// they cannot be keyed by assembly name and this is the only thing that separates them.
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB/LinqToDB.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db",
			"assemblyUidPrefixes": {
				"linq2db": "linq2db",
				"linq2db.Extensions": "linq2db.Extensions",
				"linq2db.Compat": "linq2db.Compat",
				"linq2db.FSharp": "linq2db.FSharp",
				"linq2db.Remote.Grpc": "linq2db.Remote.Grpc",
				"linq2db.Remote.Wcf": "linq2db.Remote.Wcf",
				"linq2db.Tools": "linq2db.Tools",
				"linq2db.Scaffold": "linq2db.Scaffold",
				"linq2db.Remote.HttpClient.Client": "linq2db.Remote.HttpClient.Client",
				"linq2db.Remote.HttpClient.Server": "linq2db.Remote.HttpClient.Server",
				"linq2db.Remote.SignalR.Client": "linq2db.Remote.SignalR.Client",
				"linq2db.Remote.SignalR.Server": "linq2db.Remote.SignalR.Server"
			}
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Extensions/LinqToDB.Extensions.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.extensions"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Compat/LinqToDB.Compat.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.compat"
		},
		{
			"src": [
				{
					// single target framework on purpose: the glob used to match every TFM folder,
					// which loaded the same assembly five times and reported every member of it as a
					// duplicate. netstandard2.0 is the surface available to every consumer.
					"files": [
						"linq2db/.build/bin/LinqToDB.FSharp/Release/netstandard2.0/linq2db.FSharp.dll"
					],
					"src": "../submodules"
				}
			],
			// only the net462 output carries its dependencies next to the assembly, so the F# types in
			// the public signatures are resolved from there instead of being reported unresolved.
			"references": [
				{
					"files": [
						"linq2db/.build/bin/LinqToDB.FSharp/Release/net462/FSharp.Core.dll",
						"linq2db/.build/bin/LinqToDB.FSharp/Release/net462/Microsoft.Bcl.AsyncInterfaces.dll"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.fsharp"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.Grpc/LinqToDB.Remote.Grpc.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.grpc"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.Wcf/LinqToDB.Remote.Wcf.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.wcf"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Tools/LinqToDB.Tools.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.tools"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Scaffold/LinqToDB.Scaffold.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.scaffold"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.EntityFrameworkCore/LinqToDB.EntityFrameworkCore.EF3.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.efcore.3",
			"uidPrefix": "linq2db.EntityFrameworkCore.EF3"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.EntityFrameworkCore/LinqToDB.EntityFrameworkCore.EF8.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.efcore.8",
			"uidPrefix": "linq2db.EntityFrameworkCore.EF8"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.EntityFrameworkCore/LinqToDB.EntityFrameworkCore.EF9.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.efcore.9",
			"uidPrefix": "linq2db.EntityFrameworkCore.EF9"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.EntityFrameworkCore/LinqToDB.EntityFrameworkCore.EF10.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.efcore.10",
			"uidPrefix": "linq2db.EntityFrameworkCore.EF10"
		},
		{
			"src": [
				{
					"files": [
						"LinqToDB.Identity/src/LinqToDB.Identity/LinqToDB.Identity.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.identity"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.HttpClient.Client/LinqToDB.Remote.HttpClient.Client.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.httpclient.client"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.HttpClient.Server/LinqToDB.Remote.HttpClient.Server.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.httpclient.server"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.SignalR.Client/LinqToDB.Remote.SignalR.Client.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.signalr.client"
		},
		{
			"src": [
				{
					"files": [
						"linq2db/Source/LinqToDB.Remote.SignalR.Server/LinqToDB.Remote.SignalR.Server.csproj"
					],
					"src": "../submodules"
				}
			],
			"filter": "filter.yml",
			"output": "api/linq2db.remote.signalr.server"
		}
	],
	"build": {
		"content": [
			{
				"files": [
					"api/**/*.{md,yml}",
					"articles/**/*.{md,yml}",
					"toc.yml",
					"*.md"
				]
			}
		],
		"resource": [
			{
				"files": [
					"images/**",
					"**.png",
					"**.jpg",
					"articles/cli-help.txt",
					".nojekyll"
				]
			}
		],
		"dest": "../_site",
		"globalMetadataFiles": [],
		"globalMetadata": {
			//https://github.com/dotnet/docfx/blob/main/docs/docs/template.md#modern-template
			"_appTitle": "Linq To DB",
			"_appName": "Linq To DB",
			"_appFooter": "© 2011-2026 Linq To DB Team<br/>Generated by <strong><a href='https://github.com/dotnet/docfx' target='_blank'>DocFX</a></strong>",
			"_appLogoPath": "images/icon.png",
			"_appFaviconPath": "images/icon.ico",
			"_enableSearch": true,
			"_disableNewTab": false,
			"_disableContribution": true
		},
		"fileMetadataFiles": [],
		"template": [
			"default",
			"modern",
			"templates/custom"
		],
		"postProcessors": [ "ExtractSearchIndex" ],
		"noLangKeyword": false,
		"keepFileLink": false
	}
}
